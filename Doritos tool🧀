--========================================================--
-- VERIFICAR SE É PERSONAGEM DE JOGADOR
--========================================================--

local function isPlayerCharacter(model)
    for _, otherPlayer in ipairs(Players:GetPlayers()) do
        if otherPlayer.Character == model then
            return true
        end
    end

    return false
end

--========================================================--
-- LOCALIZAR TOOL
--========================================================--

local function findTool()
    local character = player.Character

    if character then
        local tool = character:FindFirstChild(TOOL_NAME)

        if tool and tool:IsA("Tool") then
            return tool
        end
    end

    local tool = backpack:FindFirstChild(TOOL_NAME)

    if tool and tool:IsA("Tool") then
        return tool
    end

    return nil
end

--========================================================--
-- CARREGAR DORITOS PELO ID
--========================================================--

local function loadDoritos()
    local existing = findTool()

    if existing then
        return existing
    end

    -- Verifica se o ambiente oferece GetObjects.
    if typeof(game.GetObjects) ~= "function" then
        warn("Doritos: GetObjects não está disponível neste ambiente.")
        return nil
    end

    local ok, objects = pcall(function()
        return game:GetObjects("rbxassetid://" .. ASSET_ID)
    end)

    if not ok or not objects or not objects[1] then
        warn("Doritos: falha ao carregar o asset " .. ASSET_ID)
        return nil
    end

    local container = objects[1]
    local tool = nil

    if container:IsA("Tool") then
        tool = container
    else
        tool = container:FindFirstChildWhichIsA("Tool", true)
    end

    if not tool then
        warn("Doritos: o asset não contém uma Tool.")
        container:Destroy()
        return nil
    end

    tool.Name = TOOL_NAME
    tool.Parent = backpack

    if container ~= tool then
        container:Destroy()
    end

    return tool
end

