--========================================================--
-- PROJÉTIL
--========================================================--

local function launchDoritos(origin, direction)
    local visual = Instance.new("Part")
    visual.Name = "DoritosVisual"
    visual.Size = Vector3.new(2.5, 2.5, 0.05)
    visual.Transparency = 1
    visual.Anchored = true
    visual.CanCollide = false
    visual.CanTouch = false
    visual.CanQuery = false
    visual.CastShadow = false
    visual.CFrame = CFrame.new(origin)
    visual.Parent = Workspace

    local hitbox = Instance.new("Part")
    hitbox.Name = "DoritosHitbox"
    hitbox.Size = Vector3.new(2.5, 2.5, 0.35)
    hitbox.Transparency = 1
    hitbox.Anchored = true
    hitbox.CanCollide = false
    hitbox.CanTouch = false
    hitbox.CanQuery = false
    hitbox.CastShadow = false
    hitbox.CFrame = CFrame.new(origin)
    hitbox.Parent = Workspace

    for _, face in ipairs({Enum.NormalId.Front, Enum.NormalId.Back}) do
        local surface = Instance.new("SurfaceGui")
        surface.Face = face
        surface.AlwaysOnTop = true
        surface.LightInfluence = 0
        surface.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
        surface.PixelsPerStud = 100
        surface.Parent = visual

        local image = Instance.new("ImageLabel")
        image.Size = UDim2.fromScale(1, 1)
        image.BackgroundTransparency = 1
        image.Image = DORITOS_IMAGE
        image.ScaleType = Enum.ScaleType.Fit
        image.Parent = surface
    end

    local params = OverlapParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude

    local excluded = {visual, hitbox}
    if player.Character then
        excluded[#excluded + 1] = player.Character
    end
    params.FilterDescendantsInstances = excluded

    local elapsed = 0
    local finished = false
    local connection

    local function cleanup()
        if finished then return end
        finished = true

        if connection then
            connection:Disconnect()
            connection = nil
        end

        if visual.Parent then visual:Destroy() end
        if hitbox.Parent then hitbox:Destroy() end
    end

    connection = RunService.RenderStepped:Connect(function(dt)
        if finished or not visual.Parent or not hitbox.Parent then
            cleanup()
            return
        end

        elapsed += dt

        local distance = math.min(elapsed * SPEED, RANGE)
        local position = origin + direction * distance

        local rotation = CFrame.Angles(
            elapsed * 7,
            elapsed * 12,
            elapsed * 9
        )

        local cf = CFrame.lookAt(position, position + direction) * rotation

        visual.CFrame = cf
        hitbox.CFrame = cf

        local parts = Workspace:GetPartBoundsInBox(
            hitbox.CFrame,
            hitbox.Size,
            params
        )

        for _, part in ipairs(parts) do
            local model = part:FindFirstAncestorOfClass("Model")

            if model and not isPlayerCharacter(model) then
                local humanoid = model:FindFirstChildOfClass("Humanoid")

                if humanoid and humanoid.Health > 0 then
                    -- Dano local: o servidor deve validar o acerto
                    -- para que o dano seja confiável em um jogo publicado.
                    humanoid.Health = math.max(0, humanoid.Health - DAMAGE)

                    playHitSound()
                    cleanup()
                    return
                end
            end
        end

        if distance >= RANGE then
            cleanup()
        end
    end)
end

--========================================================--
-- EQUIPAMENTO
--========================================================--

local function disconnectConnections()
    for _, connection in ipairs(connections) do
        connection:Disconnect()
    end
    table.clear(connections)
end

local function updateEquipped()
    local character = player.Character

    local isEquipped = character ~= nil
        and currentTool ~= nil
        and currentTool.Parent == character

    button.Visible = isEquipped
end

local function setupCharacter(character)
    disconnectConnections()
    currentTool = nil
    button.Visible = false

    local function watch(item)
        if item:IsA("Tool") and item.Name == TOOL_NAME then
            currentTool = item
            updateEquipped()
        end
    end

    for _, item in ipairs(backpack:GetChildren()) do
        watch(item)
    end

    for _, item in ipairs(character:GetChildren()) do
        watch(item)
    end

    connections[#connections + 1] = backpack.ChildAdded:Connect(watch)
    connections[#connections + 1] = character.ChildAdded:Connect(watch)

    connections[#connections + 1] = character.ChildRemoved:Connect(function(item)
        if item == currentTool then
            currentTool = findTool()
            updateEquipped()
        end
    end)

    connections[#connections + 1] = backpack.ChildRemoved:Connect(function(item)
        if item == currentTool then
            currentTool = findTool()
            updateEquipped()
        end
    end)
end

--========================================================--
-- LANÇAR
--========================================================--

button.Activated:Connect(function()
    if busy or not button.Visible then return end

    local character = player.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    local camera = Workspace.CurrentCamera

    if not root or not camera or not currentTool then return end
    if currentTool.Parent ~= character then
        updateEquipped()
        return
    end

    busy = true

    TweenService:Create(
        button,
        TweenInfo.new(0.08),
        {Size = UDim2.fromOffset(66, 66)}
    ):Play()

    task.delay(0.12, function()
        if button.Parent then
            TweenService:Create(
                button,
                TweenInfo.new(0.1),
                {Size = UDim2.fromOffset(76, 76)}
            ):Play()
        end
    end)

    local viewport = camera.ViewportSize
    local ray = camera:ViewportPointToRay(viewport.X / 2, viewport.Y / 2)

    local direction = ray.Direction.Unit
    local origin = root.Position
        + Vector3.new(0, 1.5, 0)
        + root.CFrame.LookVector * 3

    launchDoritos(origin, direction)

    task.delay(COOLDOWN, function()
        busy = false
        updateEquipped()
    end)
end)

