--========================================================--
-- LIMPAR CONEXÕES COM SEGURANÇA
--========================================================--

local function disconnectList(list)
    for i = #list, 1, -1 do
        local connection = list[i]

        if connection then
            pcall(function()
                connection:Disconnect()
            end)
        end

        list[i] = nil
    end
end

