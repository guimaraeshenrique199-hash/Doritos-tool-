--========================================================--
-- CRIAR PROJÉTIL
--========================================================--

local function launchDoritos(origin, direction)
    local hitbox = Instance.new("Part")
    hitbox.Name = "DoritosHitbox"
    hitbox.Size = PROJECTILE_SIZE
    hitbox.Transparency = 1
    hitbox.Anchored = true
    hitbox.CanCollide = false
    hitbox.CanTouch = false
    hitbox.CanQuery = false
    hitbox.CastShadow = false
    hitbox.CFrame = CFrame.new(origin)
    hitbox.Parent = Workspace

    local visual = Instance.new("Part")
    visual.Name = "DoritosVisual"
    visual.Size = Vector3.new(2.5, 2.5, 0.05)
    visual.Transparency = 1
    visual.Anchored = true
    visual.CanCollide = false
    visual.CanTouch = false
    visual.CanQuery = false
    visual.CastShadow = false
    visual.CFrame = CFrame.new(origin)
    visual.Parent = Workspace

    for _, face in ipairs({
        Enum.NormalId.Front,
        Enum.NormalId.Back
    }) do
        local surface = Instance.new("SurfaceGui")
        surface.Name = "DoritosSurface"
        surface.Face = face
        surface.AlwaysOnTop = true
        surface.LightInfluence = 0
        surface.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
        surface.PixelsPerStud = 100
        surface.Parent = visual

        local image = Instance.new("ImageLabel")
        image.Name = "DoritosImage"
        image.Size = UDim2.fromScale(1, 1)
        image.BackgroundTransparency = 1
        image.Image = DORITOS_IMAGE
        image.ScaleType = Enum.ScaleType.Fit
        image.Parent = surface
    end

    local elapsed = 0
    local finished = false
    local connection

    local overlapParams = OverlapParams.new()
    overlapParams.FilterType = Enum.RaycastFilterType.Exclude

    local excluded = {hitbox, visual}

    if player.Character then
        excluded[#excluded + 1] = player.Character
    end

    overlapParams.FilterDescendantsInstances = excluded

    local function cleanup()
        if finished then
            return
        end

        finished = true

        if connection then
            connection:Disconnect()
            connection = nil
        end

        if hitbox.Parent then
            hitbox:Destroy()
        end

        if visual.Parent then
            visual:Destroy()
        end
    end

    connection = RunService.RenderStepped:Connect(function(dt)
        if finished or not hitbox.Parent or not visual.Parent then
            cleanup()
            return
        end

        elapsed += dt

        local traveled = math.min(elapsed * SPEED, RANGE)
        local position = origin + direction * traveled

        local rotation = CFrame.Angles(
            elapsed * 7,
            elapsed * 12,
            elapsed * 9
        )

        local cf = CFrame.lookAt(
            position,
            position + direction
        ) * rotation

        hitbox.CFrame = cf
        visual.CFrame = cf

        local parts = Workspace:GetPartBoundsInBox(
            hitbox.CFrame,
            hitbox.Size,
            overlapParams
        )

        for _, part in ipairs(parts) do
            local model = part:FindFirstAncestorOfClass("Model")

            if model and not isPlayerCharacter(model) then
                local humanoid = model:FindFirstChildOfClass("Humanoid")

                if humanoid and humanoid.Health > 0 then
                    -- Atenção: alteração local; o servidor precisa
                    -- validar o dano para que seja confiável.
                    humanoid.Health = math.max(
                        0,
                        humanoid.Health - DANO_NO_NPC
                    )

                    playHitMusic()
                    cleanup()
                    return
                end
            end
        end

        if traveled >= RANGE then
            cleanup()
        end
    end)

    projectileConnections[#projectileConnections + 1] = {
        Disconnect = function()
            cleanup()
        end
    }
end

--========================================================--
-- ATUALIZAR EQUIPAMENTO
--========================================================--

local function updateEquipped()
    local character = player.Character

    equipped = character ~= nil
        and currentTool ~= nil
        and currentTool.Parent == character

    button.Visible = equipped
end

local function setupCharacter(character)
    disconnectList(connections)

    currentTool = nil
    equipped = false
    button.Visible = false

    local function watchTool(item)
        if not item:IsA("Tool") or item.Name ~= TOOL_NAME then
            return
        end

        currentTool = item
        updateEquipped()
    end

    for _, item in ipairs(backpack:GetChildren()) do
        watchTool(item)
    end

    for _, item in ipairs(character:GetChildren()) do
        watchTool(item)
    end

    connections[#connections + 1] =
        backpack.ChildAdded:Connect(watchTool)

    connections[#connections + 1] =
        character.ChildAdded:Connect(watchTool)

    connections[#connections + 1] =
        character.ChildRemoved:Connect(function(item)
            if item == currentTool then
                currentTool = findTool()
                updateEquipped()
            end
        end)

    connections[#connections + 1] =
        backpack.ChildRemoved:Connect(function(item)
            if item == currentTool then
                currentTool = findTool()
                updateEquipped()
            end
        end)
end

--========================================================--
-- BOTÃO DE LANÇAMENTO
--========================================================--

button.Activated:Connect(function()
    if busy or not equipped then
        return
    end

    local character = player.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    local camera = Workspace.CurrentCamera

    if not root or not camera or not currentTool then
        return
    end

    if currentTool.Parent ~= character then
        updateEquipped()
        return
    end

    busy = true

    TweenService:Create(
        button,
        TweenInfo.new(0.08),
        {Size = UDim2.fromOffset(66, 66)}
    ):Play()

    task.delay(0.1, function()
        if button.Parent then
            TweenService:Create(
                button,
                TweenInfo.new(0.1),
                {Size = UDim2.fromOffset(76, 76)}
            ):Play()
        end
    end)

    local viewport = camera.ViewportSize
    local ray = camera:ViewportPointToRay(
        viewport.X / 2,
        viewport.Y / 2
    )

    local direction = ray.Direction.Unit

    local origin = root.Position
        + Vector3.new(0, 1.5, 0)
        + root.CFrame.LookVector * 3

    launchDoritos(origin, direction)

    task.delay(COOLDOWN, function()
        busy = false
        updateEquipped()
    end)
end)

