--========================================================--
-- CARREGAR TOOL
--========================================================--

local function findTool()
    local character = player.Character

    local tool = backpack:FindFirstChild(TOOL_NAME)
    if tool and tool:IsA("Tool") then return tool end

    if character then
        tool = character:FindFirstChild(TOOL_NAME)
        if tool and tool:IsA("Tool") then return tool end
    end

    return nil
end

local function loadTool()
    local existing = findTool()
    if existing then return existing end

    local ok, objects = pcall(function()
        return game:GetObjects("rbxassetid://" .. ASSET_ID)
    end)

    if not ok or not objects or not objects[1] then
        warn("Doritos: não foi possível carregar o asset. Verifique o ID e as permissões.")
        return nil
    end

    local container = objects[1]
    local tool

    if container:IsA("Tool") then
        tool = container
    else
        tool = container:FindFirstChildWhichIsA("Tool", true)
    end

    if not tool then
        warn("Doritos: o asset não contém uma Tool.")
        container:Destroy()
        return nil
    end

    -- Não executa manualmente os scripts internos do pacote.
    tool.Name = TOOL_NAME
    tool.Parent = backpack

    if container ~= tool then
        container:Destroy()
    end

    return tool
end

